# Nexora POS Environment Configuration Example
# Copy this file to .env.local for local development.
# In production, set these variables in your deployment environment (e.g. Vercel, Cloud Run).

# --- MongoDB Database ---
# Connection string for MongoDB Atlas or local MongoDB instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nexora?retryWrites=true&w=majority

# --- Initial Owner Setup Key ---
# Secret pre-shared key required to register the initial primary store owner.
# Once the store owner is created, setup is permanently closed.
OWNER_SETUP_KEY=your-secure-pre-shared-setup-key-min-16-chars

# --- Transactional Email (Resend) ---
# Used for owner password recovery workflows.
# Get your API key from the Resend dashboard: https://resend.com/api-keys
# Server-only secret: NEVER prefix with NEXT_PUBLIC_ or expose to client bundles.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Sender address for transactional emails.
# In testing: You may use "Nexora POS <onboarding@resend.dev>".
# In production: You MUST verify your domain with Resend (DNS DKIM, SPF, MX records)
# and use an address from your verified domain (e.g. "Nexora POS <noreply@yourdomain.com>").
EMAIL_FROM=Nexora POS <onboarding@resend.dev>

# --- Application Base URL ---
# Trusted application URL used to construct security-sensitive links (such as password reset links).
# Prevents Host-header poisoning attacks.
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# --- Network & Reverse Proxy ---
# Set to 'true' or '1' only when running behind a trusted reverse proxy (e.g. Vercel, Cloudflare, AWS ALB)
# to trust X-Forwarded-For headers for client IP extraction.
TRUST_PROXY=false
