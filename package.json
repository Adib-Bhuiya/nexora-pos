{
  "name": "nexora-pos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "NEXORA POS: frontend-only retail point of sale (Next.js + TypeScript + Tailwind). Offline-first with IndexedDB.",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build && node scripts/build-sw.mjs",
    "preview": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:preflight": "tsx scripts/auth-preflight.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.55.0",
    "mongoose": "^9.11.2",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.30",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
